# Copy to .env. Never commit .env.
TELEGRAM_BOT_TOKEN=
SWITCH_URL=            # fill in from your Switch Console / protocol notes

# Event server (server/). Unset tokens = open routes (local dev only; the server warns).
OBSERVER_TOKEN=        # observer → POST /api/events. Generate: openssl rand -hex 32
ADMIN_TOKEN=           # POST /api/replay, /api/replay/stop
DATA_DIR=./.data       # SQLite file events.db lives here (Docker: /data)
PORT=8787              # SERVER_PORT also works
# ALLOW_OPEN=1             # let NODE_ENV=production start without both tokens (demo only)
# RATE_LIMIT_PER_MIN=120   # POSTs per IP per minute
# MAX_WS_CLIENTS=400

# Observer (observer/, runs on the Mac next to Switch Console)
SERVER_URL=http://localhost:8787   # OBSERVER_TOKEN above must match the server's
